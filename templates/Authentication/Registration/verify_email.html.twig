{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Provider\AdminContextProvider #}
{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Provider\AdminContext #}
{% set ea = ea() %}
{% extends null != ea ? ea.templatePath('layout') : '@EasyAdmin/page/login_minimal.html.twig' %}
{% trans_default_domain 'messages' %}

{% block body_class 'page-login' %}
{% set flash_messages = app.flashes %}

{% block page_title %}
    <div style="font-size: 2rem; font-weight: 700; text-align: center;">
        {{ 'registration.verification.title'|trans }}
    </div>
{% endblock %}

{% block head_favicon %}
    {% if favicon_path|default(false) %}
        <link rel="shortcut icon" href="{{ favicon_path }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block wrapper_wrapper %}
    {% set page_title = block('page_title') %}

    {% if flash_messages|length > 0 %}
        <div id="flash-messages">
            {% for label, messages in flash_messages %}
                {% for message in messages %}
                    {# the message must be translated outside of the Twig component because
                    the trans_default_domain value is ignored inside the component #}
                    {% set translated_message = message|trans %}
                    <twig:ea:Alert variant="{{ label }}" withDismissButton>
                        {{ translated_message|raw }}
                    </twig:ea:Alert>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="login-wrapper">
        <header class="main-header">
            <div id="header-logo">
                {% block header_logo %}
                    {% if page_title %}
                        {% if null != ea %}
                            <a class="logo {{ page_title|length > 14 ? 'logo-long' }}" title="{{ page_title|striptags }}" href="{{ path(ea.dashboardRouteName) }}">
                                {{ page_title|raw }}
                            </a>
                        {% else %}
                            <div class="logo {{ page_title|length > 14 ? 'logo-long' }}">
                                {{ page_title|raw }}
                            </div>
                        {% endif %}
                    {% endif %}
                {% endblock header_logo %}
            </div>
        </header>

        <section class="content">
            {{ form_start(verificationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(verificationForm) }}

                <div class="form-group">
                    <p class="form-text">
                        {{ 'registration.verification.description'|trans }}
                    </p>
                </div>

                <div class="form-group">
                    {{ form_label(verificationForm.code, 'form.EmailVerificationCodeFormType.label'|trans, {'label_attr': {'class': 'form-control-label required'}}) }}
                    <div class="form-widget">
                        {{ form_widget(verificationForm.code, {'attr': {'class': 'form-control', 'autofocus': true}}) }}
                    </div>
                    {{ form_errors(verificationForm.code) }}
                </div>

                <twig:ea:Button
                    type="submit"
                    variant="primary"
                    size="lg"
                    isBlock
                    htmlAttributes="{{ locked ? {disabled: 'disabled'} : {} }}"
                >
                    {{ 'registration.verification.confirm'|trans }}
                </twig:ea:Button>
            
            {{ form_end(verificationForm) }}

            <div class="mt-3 text-center">
            {% if locked %}

                <a id="resend-link"
                href="{{ path('registration_resend_code') }}">
                    {{ 'registration.verification.resend'|trans }}
                </a>

            {% else %}

                <a id="resend-link"
                href="{{ path('registration_resend_code') }}"
                {% if resendSeconds > 0 %}style="display:none"{% endif %}>
                    {{ 'registration.verification.resend'|trans }}
                </a>

                <span id="resend-timer"
                    {% if resendSeconds == 0 %}style="display:none"{% endif %}>
                    {{ 'registration.verification.resend_after'|trans }}
                    <span id="countdown">{{ resendSeconds }}</span>
                    {{ 'registration.verification.seconds'|trans }}
                </span>

            {% endif %}
            </div>

            <div class="mt-3 text-center">
                <a href="{{ path('registration_exit') }}">
                    {{ 'registration.verification.back_to_login'|trans }}
                </a>
            </div>

            {% guard function csp_nonce %}
                <script src="{{ asset('login.js', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}" nonce="{{ csp_nonce('script') }}"></script>
            {% else %}
                <script src="{{ asset('login.js', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}"></script>
            {% endguard %}

            {% if not locked %}
            <script>
                let seconds = {{ resendSeconds }};

                if (seconds > 0) {
                    const timer = document.getElementById('resend-timer');
                    const countdown = document.getElementById('countdown');
                    const link = document.getElementById('resend-link');

                    const interval = setInterval(() => {
                        seconds--;
                        countdown.textContent = seconds;

                        if (seconds <= 0) {
                            clearInterval(interval);
                            timer.style.display = 'none';
                            link.style.display = 'inline';
                        }
                    }, 1000);
                }
            </script>
            {% endif %}

            <div class="language-switcher">
                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'ru'})) }}"
                class="{{ app.request.locale == 'ru' ? 'active' : '' }}">
                    RU
                </a>

                <span>|</span>

                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}"
                class="{{ app.request.locale == 'en' ? 'active' : '' }}">
                    EN
                </a>
            </div>

        </section>
    </div>
{% endblock %}
